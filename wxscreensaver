def load_config():
    cfg = copy.deepcopy(DEFAULTS)
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
        if isinstance(data, dict):
            cfg.update(data)
    except (OSError, ValueError):
        pass
    return sanitize_config(cfg)


def sanitize_config(cfg):
    """Hibás / elavult értékek a config.json-ban -> alapértelmezés (a GUI és a daemon ne akadjon el)."""
    choices = {"mode": ("off", "blank", "random", "one"),
               "backend": ("auto", "swayidle", "mutter"),
               "gl_driver": ("auto", "native", "zink", "mesa")}
    for k, ok in choices.items():
        if cfg.get(k) not in ok:
            cfg[k] = DEFAULTS[k]
    for k, lo in (("timeout", 1), ("cycle", 1), ("lock_after", 0)):
        try:
            cfg[k] = max(lo, int(float(cfg[k])))
        except (TypeError, ValueError, KeyError):
            cfg[k] = DEFAULTS[k]
    for k in ("selected", "lock_command"):
        if not isinstance(cfg.get(k), str):
            cfg[k] = DEFAULTS[k]
    if not isinstance(cfg.get("disabled"), list):
        cfg["disabled"] = []
    opts = cfg.get("options")
    cfg["options"] = ({k: v for k, v in opts.items() if isinstance(v, dict)}
                      if isinstance(opts, dict) else {})
    cfg["lock"] = bool(cfg.get("lock"))
    return cfg


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = CONFIG_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
    os.replace(tmp, CONFIG_FILE)


def self_exe():
    return shutil.which("wxscreensaver") or os.path.abspath(sys.argv[0])


SYSTEM_AUTOSTART = "/etc/xdg/autostart/wxscreensaver.desktop"   # a csomag (PKGBUILD) telepíti


def is_autostart():
    """A felhasználói fájl felülírja a rendszerszintűt (azonos fájlnév = azonos XDG autostart-bejegyzés)."""
    if os.path.exists(AUTOSTART_FILE):
        try:
            with open(AUTOSTART_FILE, "r", encoding="utf-8") as f:
                return not re.search(r"^Hidden\s*=\s*true\s*$", f.read(), re.I | re.M)
        except OSError:
            return True
    return os.path.exists(SYSTEM_AUTOSTART)


def set_autostart(on):
    if on:
        os.makedirs(os.path.dirname(AUTOSTART_FILE), exist_ok=True)
        with open(AUTOSTART_FILE, "w", encoding="utf-8") as f:
            f.write("[Desktop Entry]\nType=Application\nName=wxscreensaver\n"
                    "Comment=Wayland screensaver daemon\n"
                    "Exec=%s --daemon\nNoDisplay=true\n"
                    "X-GNOME-Autostart-enabled=true\n" % self_exe())
    elif os.path.exists(SYSTEM_AUTOSTART):
        # rendszerszintű bejegyzést csak felülírni lehet: Hidden=true
        os.makedirs(os.path.dirname(AUTOSTART_FILE), exist_ok=True)
        with open(AUTOSTART_FILE, "w", encoding="utf-8") as f:
            f.write("[Desktop Entry]\nType=Application\nName=wxscreensaver\n"
                    "Exec=wxscreensaver --daemon\nHidden=true\n")
    else:
        try:
            os.remove(AUTOSTART_FILE)
        except OSError:
            pass


