    except OSError:
        return "/dev/null"
    return os.path.join(d, name + ".log")


_GLVIS = {}


def gl_visual_id():
    """A legjobb GLX visual azonosítója – ugyanaz, amit az xscreensaver daemon használ.

    A GL hackek csak olyan ablakba tudnak rajzolni, aminek a visualja GLX-képes
    (mélységi puffer, dupla pufferelés); az alapértelmezett visual gyakran nem az.
    """
    if "id" in _GLVIS:
        return _GLVIS["id"]
    vid = None
    for name, args in (("xscreensaver-gl-visual", []), ("xscreensaver-gl-helper", []),
                       ("glxinfo", ["-b"])):
        exe = None
        for d in HACK_DIRS:
            p = os.path.join(d, name)
            if os.path.isfile(p) and os.access(p, os.X_OK):
                exe = p
                break
        exe = exe or shutil.which(name)
        if not exe:
            continue
        try:
            out = subprocess.run([exe] + args, capture_output=True, text=True,
                                 timeout=10).stdout
        except Exception:
            continue
        # a kimenet csak az azonosító legyen (külön sorban); ha nem, az első 0x… alakú szám
        m = (re.search(r"^\s*(0x[0-9a-fA-F]+|[1-9]\d*)\s*$", out, re.M)
             or re.search(r"\b(0x[0-9a-fA-F]+)\b", out))
        if m:
            try:
                vid = int(m.group(1), 0)
            except ValueError:
                continue
            break
    if vid is None:
        log("Nem találtam GL visualt (xscreensaver-gl-helper / glxinfo) – a GL hackek feketék lehetnek.")
    else:
        log("GL visual: 0x%x" % vid)
    _GLVIS["id"] = vid
    return vid


def apply_gl_visual(win):
    """GL-képes visual beállítása egy (még nem realizált) ablakra."""
    vid = gl_visual_id()
    if not vid:
        return
    try:
        vis = GdkX11.X11Screen.lookup_visual(win.get_screen(), vid)
        if vis is not None:
            win.set_visual(vis)
        else:
            log("A GDK nem ismeri a 0x%x visualt" % vid)
    except Exception as e:
        log("GL visual beállítása sikertelen:", e)


# --- GL driver tartalék -----------------------------------------------------
# Az új xscreensaver a GL hackekhez EGL-t használ. Néhány rendszeren (pl. NVIDIA
# + Xwayland) az eglCreatePlatformWindowSurface hibával leáll; a Mesa EGL-je viszont
# működik. "auto" módban ha egy hack EGL/GLX hibával azonnal kilép, lépcsőzetesen
# átváltunk: native -> zink (Mesa a GPU Vulkan-ján) -> mesa (szoftveres llvmpipe).
GL_LEVELS = ("native", "zink", "mesa")
_GLSTATE = {"level": None}


def _gl_state_path():
    return os.path.join(GLib.get_user_cache_dir(), "wxscreensaver", "gl_level")


def gl_auto_level(reload=False):
    if _GLSTATE["level"] is None or reload:
        lvl = "native"
        try:
            with open(_gl_state_path(), "r") as f:
                v = f.read().strip()
            if v in GL_LEVELS:
                lvl = v
        except OSError:
            pass
        _GLSTATE["level"] = lvl
    return _GLSTATE["level"]


def gl_set_auto_level(level):
    _GLSTATE["level"] = level
    try:
        os.makedirs(os.path.dirname(_gl_state_path()), exist_ok=True)
        with open(_gl_state_path(), "w") as f:
            f.write(level)
    except OSError:
        pass


def gl_level(cfg):
    g = cfg.get("gl_driver", "auto")
    if g == "auto":
        return gl_auto_level()
    return g if g in GL_LEVELS else "native"


def gl_env(level):
    """Környezeti változók a hackeknek az adott GL-szinthez."""
    if level == "native":
        return {}
    env = {"__GLX_VENDOR_LIBRARY_NAME": "mesa"}
    for p in sorted(glob.glob("/usr/share/glvnd/egl_vendor.d/*mesa*.json")):
        env["__EGL_VENDOR_LIBRARY_FILENAMES"] = p
        break
    if level == "zink":
        env["MESA_LOADER_DRIVER_OVERRIDE"] = "zink"
    else:
        env["LIBGL_ALWAYS_SOFTWARE"] = "1"
        env["GALLIUM_DRIVER"] = "llvmpipe"
    return env


def gl_failed(name):
    """A hack hibanaplója EGL/GLX/OpenGL hibára utal?"""
    try:
        with open(hack_log_path(name), "r", errors="replace") as f:
            text = f.read(20000)
    except OSError:
        return False
    return re.search(r"egl|glx|opengl", text, re.I) is not None


def gl_escalate(cfg, seen_level):
    """Átlép a tartalék-lista következő elemére (csak "auto" módban); az új szintet adja
    vissza, vagy None-t, ha nincs több tartalék."""
    if cfg.get("gl_driver", "auto") != "auto":
        return None
    cur = gl_auto_level()
    if cur != seen_level:          # közben másik monitor/előnézet már váltott
        return cur
    i = GL_LEVELS.index(cur)
    if i + 1 >= len(GL_LEVELS):
        return None
    nxt = GL_LEVELS[i + 1]
    gl_set_auto_level(nxt)
    log("GL hiba a '%s' szinten – átváltok erre: %s" % (cur, nxt))
    return nxt


class HackProc:
    def __init__(self, on_exit=None):
        self.proc = None
        self.gen = 0
        self.on_exit = on_exit

    def start(self, argv, env=None):
        self.stop()
        launcher = Gio.SubprocessLauncher.new(Gio.SubprocessFlags.NONE)
        if not DEBUG:
            launcher.set_stdout_file_path("/dev/null")
            launcher.set_stderr_file_path(hack_log_path(os.path.basename(argv[0])))
        path = os.environ.get("PATH", "/usr/bin")
        for d in HACK_DIRS:
            if os.path.isdir(d):
                path = d + ":" + path
        launcher.setenv("PATH", path, True)
        for k, v in (env or {}).items():
            launcher.setenv(k, v, True)
        try:
            p = launcher.spawnv(argv)
        except GLib.Error as e:
            log("Hack indítása sikertelen:", argv[0], e.message)
            return False
        self.proc = p
        self.gen += 1
        gen, t0 = self.gen, time.monotonic()
        p.wait_async(None, lambda pr, res: self._done(pr, res, gen, t0))
        return True

    def _done(self, pr, res, gen, t0):
        try:
            pr.wait_finish(res)
        except GLib.Error:
            pass
        if gen != self.gen:
            return
        self.proc = None
        if self.on_exit:
            self.on_exit(time.monotonic() - t0)

    def stop(self):
        p, self.proc = self.proc, None
        self.gen += 1
        if p is None:
            return
        try:
            p.send_signal(signal.SIGTERM)
        except Exception:
            return

        def kill():
            try:
                p.force_exit()
            except Exception:
                pass
            return False
        GLib.timeout_add(1500, kill)


