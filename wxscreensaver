class Head:
    """Egy monitor: fekete ablak + a benne futó hack."""

    def __init__(self, saver, index):
        self.saver = saver
        self.index = index
        self.proc = HackProc(self._on_exit)
        self.cur = None
        self.running = False
        self.fails = 0
        self.p0 = None
        self.level = "native"

        display = Gdk.Display.get_default()
        monitor = display.get_monitor(index)
        geo = monitor.get_geometry()

        win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        win.set_title("wxscreensaver")
        win.set_decorated(False)
        win.set_keep_above(True)
        win.set_skip_taskbar_hint(True)
        win.set_skip_pager_hint(True)
        win.set_app_paintable(True)
        win.set_can_focus(True)
        win.get_style_context().add_class("wxss-black")
        apply_gl_visual(win)
        win.set_default_size(geo.width, geo.height)
        win.move(geo.x, geo.y)
        win.add_events(Gdk.EventMask.KEY_PRESS_MASK | Gdk.EventMask.BUTTON_PRESS_MASK |
                       Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.SCROLL_MASK)
        for sig in ("key-press-event", "button-press-event", "motion-notify-event", "scroll-event"):
            win.connect(sig, self._on_event)

        area = Gtk.DrawingArea()
        area.connect("draw", self._draw)
        area.connect("realize", self._realize)
        area.connect("map", lambda *_: GLib.timeout_add(600, self._first_launch))
        win.add(area)
        self.window, self.area = win, area

        win.show_all()
        try:
            win.fullscreen_on_monitor(display.get_default_screen(), index)
        except Exception:
            win.fullscreen()
        win.present()

    # -- rajzolás / ablak
    def _realize(self, area):
        gw = area.get_window()
        try:
            gw.ensure_native()
            gw.set_background_rgba(Gdk.RGBA(0, 0, 0, 1))
        except Exception:
            pass
        blank = Gdk.Cursor.new_for_display(Gdk.Display.get_default(), Gdk.CursorType.BLANK_CURSOR)
        gw.set_cursor(blank)
        top = self.window.get_window()
        if top:
            top.set_cursor(blank)

    def _draw(self, w, cr):
        if not self.running:
            cr.set_source_rgb(0, 0, 0)
            cr.paint()
        return True

    def xid(self):
        gw = self.area.get_window()
        return GdkX11.X11Window.get_xid(gw) if gw else 0

    # -- bemenet -> kilépés
    def _on_event(self, w, ev):
        if time.monotonic() - self.saver.t0 < 1.0:
            return False
        if ev.type == Gdk.EventType.MOTION_NOTIFY:
            if self.p0 is None:
                self.p0 = (ev.x_root, ev.y_root)
                return False
            if abs(ev.x_root - self.p0[0]) + abs(ev.y_root - self.p0[1]) < 10:
                return False
        GLib.idle_add(self.saver.daemon.deactivate)
        return True

    # -- hack indítása
    def _first_launch(self):
        if self.saver.active:
            self.launch()
        return False

    def launch(self, hack="auto"):
        if hack == "auto":
            hack = self.saver.pick(self.cur)
        self.cur = hack
        self.proc.stop()
        self.running = False
        if hack is None:
            self.area.queue_draw()
            return
        xid = self.xid()
        if not xid:
            self.area.queue_draw()
            return
        cfg = self.saver.daemon.cfg
        opts = cfg["options"].get(hack.name, {})
        self.level = gl_level(cfg)
        self.running = self.proc.start(hack.argv(opts, xid), gl_env(self.level))
        if not self.running:
            self._on_exit(0)
        self.area.queue_draw()

    def switch(self):
        self.proc.stop()
        self.running = False
        self.area.queue_draw()
        GLib.timeout_add(300, self._relaunch)

    def _relaunch(self):
        if self.saver.active:
            self.launch()
        return False

    def _relaunch_same(self):
        if self.saver.active and self.cur is not None:
            self.launch(self.cur)
        return False

    def _on_exit(self, runtime):
        self.running = False
        if runtime < 3 and self.cur is not None:
            log("%s gyorsan kilépett, hibanapló: %s" % (
                self.cur.name, hack_log_path(self.cur.name)))
            if gl_failed(self.cur.name) and gl_escalate(self.saver.daemon.cfg, self.level):
                self.fails = 0
                self.area.queue_draw()
                GLib.timeout_add(200, self._relaunch_same)
                return
        self.fails = self.fails + 1 if runtime < 3 else 0
        if self.fails >= 5:
            log("A hack(ek) folyton kilépnek, üres képernyő marad.")
            self.cur = None
            self.area.queue_draw()
            return
        self.area.queue_draw()
        GLib.timeout_add(300, self._relaunch)

    def close(self):
        self.proc.stop()
        self.window.destroy()


class Saver:
    def __init__(self, daemon):
        self.daemon = daemon
        self.heads = []
        self.active = False
        self.t0 = time.monotonic()
        self.cycle_src = None

    def start(self):
        if not ensure_gtk():
            return False
        install_css()
        display = Gdk.Display.get_default()
        for i in range(max(1, display.get_n_monitors())):
            self.heads.append(Head(self, i))
        self.active = True
        cyc = int(self.daemon.cfg["cycle"]) * 60
        if cyc > 0 and self.daemon.cfg["mode"] in ("random", "off"):
            self.cycle_src = GLib.timeout_add_seconds(cyc, self._cycle)
        return True

    def _cycle(self):
        for h in self.heads:
            h.switch()
        return True

    def pick(self, avoid=None):
        cfg = self.daemon.cfg
        hacks = self.daemon.hacks()
        mode = cfg["mode"]
        if mode == "blank" or not hacks:
            return None
        if mode == "one" and cfg["selected"] in hacks:
            return hacks[cfg["selected"]]
        pool = [h for n, h in hacks.items() if n not in cfg["disabled"]]
        if avoid is not None and len(pool) > 1:
            pool = [h for h in pool if h is not avoid]
        return random.choice(pool) if pool else None

    def stop(self):
        self.active = False
        if self.cycle_src:
            GLib.source_remove(self.cycle_src)
            self.cycle_src = None
        for h in self.heads:
            h.close()
        self.heads = []


