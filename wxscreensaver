CTL_XML = """<node><interface name="org.wxscreensaver.Control">
<method name="Activate"/><method name="Deactivate"/><method name="Lock"/>
<method name="Reload"/><method name="Quit"/>
<method name="Status"><arg type="s" direction="out"/></method>
</interface></node>"""

FDO_XML = """<node><interface name="org.freedesktop.ScreenSaver">
<method name="Lock"/>
<method name="SimulateUserActivity"/>
<method name="GetActive"><arg type="b" direction="out"/></method>
<method name="GetActiveTime"><arg type="u" direction="out"/></method>
<method name="GetSessionIdleTime"><arg type="u" direction="out"/></method>
<method name="SetActive"><arg type="b" direction="in"/><arg type="b" direction="out"/></method>
<method name="Inhibit"><arg type="s" direction="in"/><arg type="s" direction="in"/><arg type="u" direction="out"/></method>
<method name="UnInhibit"><arg type="u" direction="in"/></method>
<method name="Throttle"><arg type="s" direction="in"/><arg type="s" direction="in"/><arg type="u" direction="out"/></method>
<method name="UnThrottle"><arg type="u" direction="in"/></method>
<signal name="ActiveChanged"><arg type="b"/></signal>
</interface></node>"""


class Daemon:
    def __init__(self):
        self.cfg = load_config()
        self._hacks = None
        self.loop = GLib.MainLoop()
        self.conn = None
        self.backend = None
        self.saver = None
        self.pending_idle = False
        self.inhibits = {}       # cookie -> (sender, app, reason, watch id)
        self.next_cookie = 1
        self.lock_src = None
        self.recheck_src = None

    def hacks(self):
        if self._hacks is None:
            self._hacks = load_hacks()
            log("%d képernyőkímélő található" % len(self._hacks))
        return self._hacks

    # -- indulás
    def run(self):
        ensure_display()
        Gio.bus_own_name(Gio.BusType.SESSION, BUS_NAME, Gio.BusNameOwnerFlags.DO_NOT_QUEUE,
                         self._on_bus, self._on_acquired, self._on_lost)
        for s in (signal.SIGTERM, signal.SIGINT):
            unix_signal_add(s, self._on_term)
        self.loop.run()

    def _on_lost(self, conn, name):
        log("A wxscreensaver daemon már fut (vagy nincs session bus).")
        self.loop.quit()

    def _on_term(self, *a):
        self.quit()
        return False

    def _on_bus(self, conn, name):
        self.conn = conn
        ctl = Gio.DBusNodeInfo.new_for_xml(CTL_XML).interfaces[0]
        conn.register_object(CTL_PATH, ctl, self._on_ctl_call, None, None)
        fdo = Gio.DBusNodeInfo.new_for_xml(FDO_XML).interfaces[0]
        for p in FDO_PATHS:
            conn.register_object(p, fdo, self._on_fdo_call, None, None)
        Gio.bus_own_name_on_connection(
            conn, FDO_NAME, Gio.BusNameOwnerFlags.DO_NOT_QUEUE, None,
            lambda c, n: log("%s foglalt (GNOME-on a gnome-shell birtokolja) – "
                             "az inhibitet ilyenkor az org.gnome.SessionManager-en át kérdezem le" % FDO_NAME))

    def _on_acquired(self, conn, name):
        self.start_backend()
        log("Daemon elindult (backend: %s)" % (self.backend.name if self.backend else "nincs"))

    def start_backend(self):
        if self.backend:
            self.backend.stop()
            self.backend = None
        want = self.cfg.get("backend", "auto")
        cls = None
        if want == "mutter" or (want == "auto" and MutterBackend.available()):
            cls = MutterBackend
        elif want in ("swayidle", "auto") and SwayidleBackend.available():
            cls = SwayidleBackend
        if cls is None:
            log("Nincs tétlenség-érzékelő backend. Telepítsd a swayidle csomagot!")
            return
        b = cls()
        try:
            b.start(max(60, int(float(self.cfg["timeout"]) * 60)), self.on_idle, self.on_resume)
        except Exception as e:
            log("Backend indítása sikertelen:", e)
            return
        self.backend = b

    # -- esemény-kezelés
    def _inhibited(self):
        """Van aktív inhibit (saját D-Bus, vagy GNOME-on az org.gnome.SessionManager "idle" jelzője)?"""
        if self.inhibits:
            return True
        try:
            r = self.conn.call_sync(
                "org.gnome.SessionManager", "/org/gnome/SessionManager",
                "org.gnome.SessionManager", "IsInhibited", GLib.Variant("(u)", (8,)),
                GLib.VariantType("(b)"), Gio.DBusCallFlags.NO_AUTO_START, 500, None)
            return bool(r.unpack()[0])
        except Exception:
            return False

    def on_idle(self):
        if self.saver or self.cfg["mode"] == "off":
            return
        if self._inhibited():
            log("Tétlenség, de van inhibit – kivárok")
            self.pending_idle = True
            if self.backend:
                self.backend.watch_resume()     # ha közben megmozdul a felhasználó, ne induljon el
            if not self.recheck_src:
                self.recheck_src = GLib.timeout_add_seconds(15, self._recheck)
            return
        self.activate()

    def _recheck(self):
        if not self.pending_idle or self.saver:
            self.recheck_src = None
            return False
        if self._inhibited():
            return True
        self.recheck_src = None
        self.activate()
        return False

    def _cancel_recheck(self):
        if self.recheck_src:
            GLib.source_remove(self.recheck_src)
            self.recheck_src = None

    def on_resume(self):
        self.pending_idle = False
        self._cancel_recheck()
        if self.saver:
            self.deactivate()
        elif self.backend:
            self.backend.cancel_resume()

    def activate(self):
        if self.saver:
            return
        self.pending_idle = False
        saver = Saver(self)
        if not saver.start():
            saver.stop()
            return
        self.saver = saver
        if self.backend:
            self.backend.watch_resume()
        if self.cfg["lock"]:
            after = max(0, int(self.cfg["lock_after"])) * 60
            self.lock_src = GLib.timeout_add_seconds(max(1, after), self._lock_timer)
        self._emit_active(True)

    def deactivate(self):
        if not self.saver:
            return False
        self.saver.stop()
        self.saver = None
        if self.lock_src:
            GLib.source_remove(self.lock_src)
            self.lock_src = None
        if self.backend:
            self.backend.cancel_resume()
        self._emit_active(False)
        return False

    def _lock_timer(self):
        self.lock_src = None
        self.run_lock()
        return False

    def run_lock(self):
        cmd = (self.cfg.get("lock_command") or "").strip()
        if not cmd:
            return
        try:
            subprocess.Popen(shlex.split(cmd), start_new_session=True)
        except Exception as e:
            log("Zároló parancs hiba:", e)

    def _emit_active(self, on):
        if not self.conn:
            return
        for p in FDO_PATHS:
            try:
                self.conn.emit_signal(None, p, FDO_NAME, "ActiveChanged", GLib.Variant("(b)", (on,)))
            except Exception:
                pass

    def reload(self):
        self.cfg = load_config()
        self._hacks = None
        gl_auto_level(reload=True)
        self.start_backend()

    def quit(self):
        self._cancel_recheck()
        self.deactivate()
        if self.backend:
            self.backend.stop()
        self.loop.quit()

    def status(self):
        return "%s; backend=%s; timeout=%smin; inhibitors=%d; mode=%s" % (
            "active" if self.saver else "idle",
            self.backend.name if self.backend else "none",
            self.cfg["timeout"], len(self.inhibits), self.cfg["mode"])

    # -- D-Bus: vezérlés
    def _on_ctl_call(self, conn, sender, path, iface, method, params, inv):
        try:
            if method == "Activate":
                self.activate()
            elif method == "Deactivate":
                self.deactivate()
            elif method == "Lock":
                self.run_lock()
            elif method == "Reload":
                self.reload()
            elif method == "Quit":
                inv.return_value(None)
                GLib.idle_add(self.quit)
                return
            elif method == "Status":
                inv.return_value(GLib.Variant("(s)", (self.status(),)))
                return
            inv.return_value(None)
        except Exception as e:
            inv.return_dbus_error("org.wxscreensaver.Error", str(e))

    # -- D-Bus: org.freedesktop.ScreenSaver
    def _on_fdo_call(self, conn, sender, path, iface, method, params, inv):
        try:
            if method in ("Inhibit", "Throttle"):
                app, reason = params.unpack()
                cookie = self._inhibit(sender, app, reason) if method == "Inhibit" else 0
                inv.return_value(GLib.Variant("(u)", (cookie,)))
            elif method == "UnInhibit":
                self._uninhibit(params.unpack()[0])
                inv.return_value(None)
            elif method == "GetActive":
                inv.return_value(GLib.Variant("(b)", (self.saver is not None,)))
            elif method in ("GetActiveTime", "GetSessionIdleTime"):
                inv.return_value(GLib.Variant("(u)", (0,)))
            elif method == "SetActive":
                on = params.unpack()[0]
                GLib.idle_add(self.activate if on else self.deactivate)
                inv.return_value(GLib.Variant("(b)", (True,)))
            elif method == "Lock":
                self.run_lock()
                inv.return_value(None)
            elif method == "SimulateUserActivity":
                self.on_resume()
                inv.return_value(None)
            else:
                inv.return_value(None)
        except Exception as e:
            inv.return_dbus_error("org.freedesktop.DBus.Error.Failed", str(e))

    def _inhibit(self, sender, app, reason):
        cookie = self.next_cookie
        self.next_cookie += 1
        wid = Gio.bus_watch_name_on_connection(
            self.conn, sender, Gio.BusNameWatcherFlags.NONE, None,
            lambda c, n: self._sender_gone(n))
        self.inhibits[cookie] = (sender, app, reason, wid)
        log("Inhibit: %s (%s)" % (app, reason))
        return cookie

    def _uninhibit(self, cookie):
        item = self.inhibits.pop(cookie, None)
        if not item:
            return
        GLib.idle_add(lambda: (Gio.bus_unwatch_name(item[3]), False)[1])
        if not self.inhibits and self.pending_idle:
            self.pending_idle = False
            self.activate()

    def _sender_gone(self, sender):
        for cookie in [c for c, v in self.inhibits.items() if v[0] == sender]:
            self._uninhibit(cookie)


