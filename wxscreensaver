# xscreensaver hackek felderítése (XML-leírások)
# --------------------------------------------------------------------------
class Hack:
    def __init__(self, name, label, desc, binary, base_args, controls):
        self.name = name
        self.label = label
        self.desc = desc
        self.binary = binary
        self.base_args = base_args
        self.controls = controls

    def argv(self, values, xid):
        args = []
        for c in self.controls:
            args += control_args(c, values.get(c["id"], c["default"]))
        base = [a for a in self.base_args if a != "-root"]
        return [self.binary] + base + args + ["-window-id", hex(xid)]


def control_args(c, v):
    t = c["type"]
    if t == "bool":
        if v and c["set"]:
            return shlex.split(c["set"])
        if (not v) and c["unset"]:
            return shlex.split(c["unset"])
    elif t == "select":
        for o in c["options"]:
            if o["id"] == v and o["arg"]:
                return shlex.split(o["arg"])
    elif t == "number":
        try:
            x = float(v)
        except (TypeError, ValueError):
            return []
        if abs(x - c["default"]) < 1e-9 or not c["arg"]:
            return []
        s = str(int(round(x))) if c["int"] else ("%g" % x)
        return [tok.replace("%", s) for tok in shlex.split(c["arg"])]
    elif t == "string":
        if v and c["arg"]:
            return [tok.replace("%", str(v)) for tok in shlex.split(c["arg"])]
    return []


def _clean_text(text):
    paras = re.split(r"\n\s*\n", (text or "").strip())
    return "\n\n".join(" ".join(p.split()) for p in paras if p.strip())


def parse_hack(path):
    try:
        root = ET.parse(path).getroot()
    except Exception:
        return None
    if root.tag != "screensaver":
        return None
    name = root.get("name")
    if not name:
        return None
    binary = None
    for d in HACK_DIRS:
        p = os.path.join(d, name)
        if os.path.isfile(p) and os.access(p, os.X_OK):
            binary = p
            break
    if not binary:
        binary = shutil.which(name)
    if not binary:
        return None

    base = []
    for cmd in root.findall("command"):
        a = cmd.get("arg")
        if a:
            try:
                base += shlex.split(a)
            except ValueError:
                pass

    desc_el = root.find("_description")
    desc = _clean_text("".join(desc_el.itertext())) if desc_el is not None else ""

    controls = []
    idx = 0
    for el in root.iter():
        t = el.tag
        if t not in ("number", "boolean", "select", "string"):
            continue
        idx += 1
        cid = el.get("id") or "c%d" % idx
        label = el.get("_label") or ""
        try:
            if t == "number":
                arg = el.get("arg") or ""
                if not arg:
                    continue
                low = float(el.get("low", "0"))
                high = float(el.get("high", "100"))
                default = float(el.get("default", el.get("low", "0")))
                isint = all("." not in (el.get(k) or "") for k in ("low", "high", "default"))
                controls.append(dict(
                    type="number", id=cid, label=label or cid, arg=arg,
                    low=low, high=high, default=default, int=isint,
                    invert=(el.get("convert") == "invert"),
                    low_label=el.get("_low-label") or "",
                    high_label=el.get("_high-label") or "",
                    widget=el.get("type") or "slider"))
            elif t == "boolean":
                aset = el.get("arg-set") or ""
                aunset = el.get("arg-unset") or ""
                if not aset and not aunset:
                    continue
                default = False if (aset and not aunset) else True
                controls.append(dict(type="bool", id=cid, label=label or cid,
                                     set=aset, unset=aunset, default=default))
            elif t == "select":
                opts = []
                for i, o in enumerate(el.findall("option")):
                    opts.append(dict(id=o.get("id") or "o%d" % i,
                                     label=o.get("_label") or o.get("id") or "?",
                                     arg=o.get("arg-set") or ""))
                if len(opts) < 2:
                    continue
                default = next((o["id"] for o in opts if not o["arg"]), opts[0]["id"])
                controls.append(dict(type="select", id=cid, label=label,
                                     options=opts, default=default))
            elif t == "string":
                arg = el.get("arg") or el.get("arg-set") or ""
                if not arg:
                    continue
                controls.append(dict(type="string", id=cid, label=label or cid,
                                     arg=arg, default=""))
        except ValueError:
            continue
    return Hack(name, root.get("_label") or name, desc, binary, base, controls)


def load_hacks():
    hacks = {}
    for d in CONFIG_XML_DIRS:
        for f in sorted(glob.glob(os.path.join(d, "*.xml"))):
            h = parse_hack(f)
            if h and h.name not in hacks:
                hacks[h.name] = h
    ordered = sorted(hacks.values(), key=lambda h: h.label.lower())
    return {h.name: h for h in ordered}


