        self.prev = HackProc(self._prev_exit)

        install_css()
        win = Gtk.Window(title="wxscreensaver")
        apply_gl_visual(win)   # az előnézetben a GL hackek is működjenek
        win.set_default_size(1050, 680)
        win.connect("destroy", self._quit)
        self.win = win

        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        stack = Gtk.Stack()
        stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        sw = Gtk.StackSwitcher()
        sw.set_stack(stack)
        header.set_custom_title(sw)
        test = Gtk.Button(label=tr("Test"))
        test.get_style_context().add_class("suggested-action")
        test.connect("clicked", self._on_test)
        header.pack_start(test)
        win.set_titlebar(header)

        stack.add_titled(self._build_hacks_page(), "hacks", tr("Screensavers"))
        stack.add_titled(self._build_settings_page(), "settings", tr("Settings"))
        stack.connect("notify::visible-child-name", lambda *a: self._refresh_status())
        win.add(stack)
        win.show_all()
        self._update_mode_ui()

        first = None
        for row in self.listbox.get_children():
            if row.hack.name == self.cfg.get("selected"):
                first = row
                break
        first = first or (self.listbox.get_row_at_index(0))
        if first:
            self.listbox.select_row(first)

    # ---- hack oldal
    def _build_hacks_page(self):
        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        paned.set_position(330)

        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        left.set_border_width(10)
        mrow = Gtk.Box(spacing=8)
        mrow.pack_start(Gtk.Label(label=tr("Mode:")), False, False, 0)
        self.mode = Gtk.ComboBoxText()
        for mid, text in self.MODES:
            self.mode.append(mid, tr(text))
        self.mode.set_active_id(self.cfg["mode"])
        self.mode.connect("changed", self._on_mode)
        mrow.pack_start(self.mode, True, True, 0)
        left.pack_start(mrow, False, False, 0)

        self.hint = Gtk.Label(label=tr("Select the screensaver from the list."), xalign=0)
        self.hint.set_line_wrap(True)
        self.hint.set_no_show_all(True)
        left.pack_start(self.hint, False, False, 0)

        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text(tr("Search…"))
        self.search.connect("search-changed", lambda *_: self.listbox.invalidate_filter())
        left.pack_start(self.search, False, False, 0)

        self.listbox = Gtk.ListBox()
        self.listbox.set_filter_func(self._filter)
        self.listbox.connect("row-selected", self._on_row)
        for h in self.hacks.values():
            row = Gtk.ListBoxRow()
            row.hack = h
            box = Gtk.Box(spacing=8)
            box.set_border_width(4)
            chk = Gtk.CheckButton()
            chk.set_active(h.name not in self.cfg["disabled"])
            chk.connect("toggled", self._on_check, h)
            chk.set_no_show_all(True)
            row.chk = chk
            box.pack_start(chk, False, False, 0)
            lab = Gtk.Label(label=h.label, xalign=0)
            box.pack_start(lab, True, True, 0)
            row.add(box)
            self.listbox.add(row)
        scroll = Gtk.ScrolledWindow()
        scroll.add(self.listbox)
        left.pack_start(scroll, True, True, 0)

        brow = Gtk.Box(spacing=8)
        b1 = Gtk.Button(label=tr("Check all"))
        b2 = Gtk.Button(label=tr("Uncheck all"))
        b1.connect("clicked", lambda *_: self._check_all(True))
        b2.connect("clicked", lambda *_: self._check_all(False))
        self.btn_all = (b1, b2)
        brow.pack_start(b1, True, True, 0)
        brow.pack_start(b2, True, True, 0)
        left.pack_start(brow, False, False, 0)
        paned.pack1(left, False, False)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        right.set_border_width(12)
        self.preview = Gtk.DrawingArea()
        self.preview.set_size_request(480, 270)
        self.preview.connect("draw", self._prev_draw)
        self.preview.connect("realize", self._prev_realize)
        frame = Gtk.AspectFrame(xalign=0.5, yalign=0.5, ratio=16 / 9, obey_child=False)
        frame.set_shadow_type(Gtk.ShadowType.NONE)
        frame.add(self.preview)
        # fekete háttér az előnézet mögött (különben átlátszhat az asztalra)
        bg = Gtk.EventBox()
        bg.get_style_context().add_class("wxss-black")
        bg.add(frame)
        right.pack_start(bg, True, True, 0)

        self.title = Gtk.Label(xalign=0)
        right.pack_start(self.title, False, False, 0)
        self.desc = Gtk.Label(xalign=0, yalign=0)
        self.desc.set_line_wrap(True)
        self.desc.set_selectable(True)
        right.pack_start(self.desc, False, False, 0)
        self.prev_msg = Gtk.Label(xalign=0)
        right.pack_start(self.prev_msg, False, False, 0)

        ohead = Gtk.Box(spacing=8)
        lab = Gtk.Label(xalign=0)
        lab.set_markup("<b>%s</b>" % GLib.markup_escape_text(tr("Options")))
        ohead.pack_start(lab, True, True, 0)
        reset = Gtk.Button(label=tr("Reset to defaults"))
        reset.connect("clicked", self._on_reset)
        ohead.pack_end(reset, False, False, 0)
        right.pack_start(ohead, False, False, 0)

        self.opts_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        osw = Gtk.ScrolledWindow()
        osw.set_min_content_height(150)
        osw.add(self.opts_box)
        right.pack_start(osw, True, True, 0)
        paned.pack2(right, True, False)
        return paned

    def _filter(self, row):
        q = self.search.get_text().strip().lower()
        return not q or q in row.hack.label.lower() or q in row.hack.name

    def _check_all(self, on):
        for row in self.listbox.get_children():
            row.chk.set_active(on)

    def _on_check(self, chk, hack):
        dis = set(self.cfg["disabled"])
        if chk.get_active():
            dis.discard(hack.name)
        else:
            dis.add(hack.name)
        self.cfg["disabled"] = sorted(dis)
        self._changed()

    def _on_mode(self, combo):
        self.cfg["mode"] = combo.get_active_id()
        self._update_mode_ui()
        self._changed()

    def _update_mode_ui(self):
        """Jelölőnégyzetek csak véletlen módban; "csak egy" módban a kijelölt sor számít."""
        mode = self.cfg["mode"]
        for row in self.listbox.get_children():
            row.chk.set_visible(mode == "random")
        for b in self.btn_all:
            b.set_sensitive(mode == "random")
        self.hint.set_visible(mode == "one")

    def _on_row(self, lb, row):
        if row is None:
            return
        h = row.hack
        self.current = h
        self.cfg["selected"] = h.name
        self.title.set_markup("<span size='large' weight='bold'>%s</span>"
                              % GLib.markup_escape_text(h.label))
        self.desc.set_text(h.desc or tr("No description."))
        self._rebuild_options(h)
        self._schedule_preview()
        self._changed()

    def _on_reset(self, *_):
        if self.current:
            self.cfg["options"].pop(self.current.name, None)
            self._rebuild_options(self.current)
            self._schedule_preview()
            self._changed()

    # ---- hack-opciók
    def _set_opt(self, hack, cid, v):
        self.cfg["options"].setdefault(hack.name, {})[cid] = v
        self._schedule_preview()
        self._changed()

    def _rebuild_options(self, hack):
        for ch in self.opts_box.get_children():
            self.opts_box.remove(ch)
        vals = self.cfg["options"].get(hack.name, {})
        for c in hack.controls:
            cur = vals.get(c["id"], c["default"])
            t = c["type"]
            if t == "number":
                self.opts_box.pack_start(self._number_widget(hack, c, cur), False, False, 0)
            elif t == "bool":
                chk = Gtk.CheckButton(label=c["label"])
                chk.set_active(bool(cur))
                chk.connect("toggled", lambda w, h=hack, c=c: self._set_opt(h, c["id"], w.get_active()))
                self.opts_box.pack_start(chk, False, False, 0)
            elif t == "select":
                box = Gtk.Box(spacing=8)
                if c["label"]:
                    box.pack_start(Gtk.Label(label=c["label"], xalign=0), False, False, 0)
                cb = Gtk.ComboBoxText()
                for o in c["options"]:
                    cb.append(o["id"], o["label"])
                cb.set_active_id(cur if cur in [o["id"] for o in c["options"]] else c["default"])
                cb.connect("changed", lambda w, h=hack, c=c: self._set_opt(h, c["id"], w.get_active_id()))
                box.pack_start(cb, True, True, 0)
                self.opts_box.pack_start(box, False, False, 0)
            elif t == "string":
                box = Gtk.Box(spacing=8)
                box.pack_start(Gtk.Label(label=c["label"], xalign=0), False, False, 0)
                en = Gtk.Entry()
                en.set_text(str(cur or ""))
                en.connect("changed", lambda w, h=hack, c=c: self._set_opt(h, c["id"], w.get_text()))
                box.pack_start(en, True, True, 0)
                self.opts_box.pack_start(box, False, False, 0)
        self.opts_box.show_all()

    def _number_widget(self, hack, c, cur):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        box.pack_start(Gtk.Label(label=c["label"], xalign=0), False, False, 0)
        low, high = c["low"], c["high"]
        step = max(1.0, round((high - low) / 200.0)) if c["int"] else (high - low) / 200.0
        pos = (low + high - float(cur)) if c["invert"] else float(cur)

        def to_value(p):
            v = (low + high - p) if c["invert"] else p
            return int(round(v)) if c["int"] else v

        if c["widget"] == "spinbutton":
            w = Gtk.SpinButton.new_with_range(low, high, step)
            w.set_value(pos)
            w.connect("value-changed", lambda s: self._set_opt(hack, c["id"], to_value(s.get_value())))
            box.pack_start(w, False, False, 0)
            return box
        w = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, low, high, step)
        w.set_draw_value(False)
        w.set_digits(0 if c["int"] else 3)
        w.set_value(pos)
        w.connect("value-changed", lambda s: self._set_opt(hack, c["id"], to_value(s.get_value())))
        box.pack_start(w, False, False, 0)
        if c["low_label"] or c["high_label"]:
            lr = Gtk.Box()
            lr.pack_start(Gtk.Label(label=c["low_label"], xalign=0), True, True, 0)
            lr.pack_end(Gtk.Label(label=c["high_label"], xalign=1), True, True, 0)
            box.pack_start(lr, False, False, 0)
        return box

    # ---- előnézet
    def _prev_realize(self, area):
        try:
            gw = area.get_window()
            gw.ensure_native()
            gw.set_background_rgba(Gdk.RGBA(0, 0, 0, 1))
        except Exception:
            pass

    def _prev_draw(self, w, cr):
        if not self.prev_running:
            cr.set_source_rgb(0, 0, 0)
            cr.paint()
        return True

    def _schedule_preview(self):
        if self.prev_src:
            GLib.source_remove(self.prev_src)
        self.prev_running = False
        self.prev.stop()
        self.preview.queue_draw()
        self.prev_src = GLib.timeout_add(350, self._start_preview)

    def _start_preview(self):
        self.prev_src = None
        h = self.current
        gw = self.preview.get_window()
        if not h or gw is None:
            return False
        self.prev_msg.set_text("")
        xid = GdkX11.X11Window.get_xid(gw)
        argv = h.argv(self.cfg["options"].get(h.name, {}), xid)
        self.prev_level = gl_level(self.cfg)
        self.prev_running = self.prev.start(argv, gl_env(self.prev_level))
        if not self.prev_running:
            self.prev_msg.set_text(tr("Preview could not be started."))
        return False

    def _prev_exit(self, runtime):
        self.prev_running = False
        self.preview.queue_draw()
        if runtime < 3:
            h = self.current
            if h and gl_failed(h.name) and gl_escalate(self.cfg, self.prev_level):
                GLib.timeout_add(200, self._start_preview)   # újra, másik GL-driverrel
                return
            self.prev_msg.set_text(tr("Preview could not be started."))

    # ---- általános beállítások oldal
    def _build_settings_page(self):
        grid = Gtk.Grid(column_spacing=16, row_spacing=14)
        grid.set_border_width(24)
        grid.set_halign(Gtk.Align.CENTER)
        r = [0]

        def row(label, widget):
            grid.attach(Gtk.Label(label=label, xalign=1), 0, r[0], 1, 1)
            widget.set_halign(Gtk.Align.START)
            grid.attach(widget, 1, r[0], 1, 1)
            r[0] += 1

        def spin(key, lo, hi):
            s = Gtk.SpinButton.new_with_range(lo, hi, 1)
            s.set_value(float(self.cfg[key]))
            s.connect("value-changed", lambda w: self._set_cfg(key, int(w.get_value())))
            return s

        row(tr("Start after (minutes of inactivity)"), spin("timeout", 1, 720))
        row(tr("Switch screensaver every (minutes)"), spin("cycle", 1, 720))

        sw = Gtk.Switch()
        sw.set_active(bool(self.cfg["lock"]))
        sw.connect("notify::active", lambda w, _: self._set_cfg("lock", w.get_active()))
        row(tr("Lock the screen"), sw)
        row(tr("Lock after (minutes, 0 = immediately)"), spin("lock_after", 0, 720))

        en = Gtk.Entry()
        en.set_width_chars(34)
        en.set_text(self.cfg["lock_command"])
        en.connect("changed", lambda w: self._set_cfg("lock_command", w.get_text()))
        row(tr("Lock command"), en)

        note = Gtk.Label(label=tr("Locking note"), xalign=0)
        note.set_line_wrap(True)
        note.set_max_width_chars(60)
        note.get_style_context().add_class("dim-label")
        grid.attach(note, 1, r[0], 1, 1)
        r[0] += 1

        be = Gtk.ComboBoxText()
        be.append("auto", tr("Automatic"))
        be.append("swayidle", "swayidle (ext-idle-notify)")
        be.append("mutter", "GNOME / Mutter")
        be.set_active_id(self.cfg.get("backend", "auto"))
        be.connect("changed", lambda w: self._set_cfg("backend", w.get_active_id()))
        row(tr("Idle detection"), be)

        gl = Gtk.ComboBoxText()
        gl.append("auto", tr("Automatic"))
        gl.append("native", tr("System driver (e.g. NVIDIA)"))
        gl.append("zink", tr("Mesa Zink (GPU through Vulkan)"))
        gl.append("mesa", tr("Mesa software rendering"))
        gl.set_active_id(self.cfg.get("gl_driver", "auto"))
        gl.connect("changed", self._on_gl_driver)
        row(tr("OpenGL driver"), gl)

        auto = Gtk.Switch()
        auto.set_active(is_autostart())
        auto.connect("notify::active", lambda w, _: set_autostart(w.get_active()))
        row(tr("Start at login"), auto)

        drow = Gtk.Box(spacing=10)
        self.status = Gtk.Label(xalign=0)
        drow.pack_start(self.status, False, False, 0)
        rb = Gtk.Button(label=tr("Restart daemon"))
        rb.connect("clicked", self._on_restart)
        drow.pack_start(rb, False, False, 0)
        row(tr("Daemon"), drow)
        self._refresh_status()

        sc = Gtk.ScrolledWindow()
        sc.add(grid)
        return sc

    def _on_gl_driver(self, combo):
        self.cfg["gl_driver"] = combo.get_active_id()
        if self.cfg["gl_driver"] == "auto":
            gl_set_auto_level("native")      # újrakezdi a próbálkozást a rendszer-drivertől
        self._changed()
        self._schedule_preview()

    def _set_cfg(self, key, v):
        self.cfg[key] = v
        self._changed()

    def _refresh_status(self):
        ok, text = ctl("Status")
        self.status.set_text("%s (%s)" % (tr("running"), text) if ok else tr("not running"))

    def _on_restart(self, *_):
        ctl("Quit")
        GLib.timeout_add(700, lambda: (spawn_daemon(), GLib.timeout_add(1200, self._refresh_status), False)[2])

    def _on_test(self, *_):
        self._save_now()
        ok, _ = ctl("Activate")
        if not ok:
            spawn_daemon()
            GLib.timeout_add(1500, lambda: (ctl("Activate"), False)[1])

    # ---- mentés
    def _changed(self):
        if self.save_src:
            GLib.source_remove(self.save_src)
        self.save_src = GLib.timeout_add(600, self._save_now)

    def _save_now(self):
        self.save_src = None
        try:
            save_config(self.cfg)
        except OSError as e:
            log("Mentés sikertelen:", e)
        ctl("Reload")
        return False

    def _quit(self, *_):
        if self.save_src:
            GLib.source_remove(self.save_src)
            self._save_now()
        self.prev.stop()
        Gtk.main_quit()


def run_settings():
    if not ensure_gtk():
        print("Nem indítható a GUI: nincs elérhető X kijelző (Xwayland). "
              "Ellenőrizd, hogy az Xwayland engedélyezve van-e.", file=sys.stderr)
        return 1
    SettingsWindow()
    Gtk.main()
    return 0


# --------------------------------------------------------------------------
def main():
    p = argparse.ArgumentParser(prog="wxscreensaver",
                                description="Wayland-kompatibilis xscreensaver-pótlás")
    g = p.add_mutually_exclusive_group()
    for flag, hlp in (("daemon", "háttérszolgáltatás indítása"),
                      ("settings", "beállító ablak (alapértelmezett)"),
                      ("activate", "képernyőkímélő azonnali indítása"),
                      ("deactivate", "képernyőkímélő leállítása"),
                      ("lock", "zároló parancs futtatása"),
                      ("reload", "beállítások újratöltése"),
                      ("status", "állapot kiírása"),
                      ("quit", "daemon leállítása")):
        g.add_argument("--" + flag, action="store_true", help=hlp)
    p.add_argument("--version", action="version", version="wxscreensaver " + VERSION)
    a = p.parse_args()

    if a.daemon:
        Daemon().run()
        return 0
    for flag, method in (("activate", "Activate"), ("deactivate", "Deactivate"), ("lock", "Lock"),
                         ("reload", "Reload"), ("status", "Status"), ("quit", "Quit")):
        if getattr(a, flag):
            ok, text = ctl(method)
            if not ok:
                print("A daemon nem fut (%s)" % text, file=sys.stderr)
                return 1
            if text:
                print(text)
            return 0
    return run_settings()


if __name__ == "__main__":
    sys.exit(main())
