def _pdeathsig():
    try:
        import ctypes
        ctypes.CDLL("libc.so.6").prctl(1, int(signal.SIGTERM))  # PR_SET_PDEATHSIG
    except Exception:
        pass


def _sig_handler(cb):
    def f(*a):
        cb()
        return True
    return f


class SwayidleBackend:
    """swayidle (ext-idle-notify-v1): wlroots-alapú compositorok, KDE, stb."""
    name = "swayidle"

    @staticmethod
    def available():
        return shutil.which("swayidle") is not None

    def __init__(self):
        self.main = None
        self.helper = None
        self.srcs = []

    def start(self, timeout_s, on_idle, on_resume):
        pid = os.getpid()
        self.srcs = [
            unix_signal_add(signal.SIGUSR1, _sig_handler(on_idle)),
            unix_signal_add(signal.SIGUSR2, _sig_handler(on_resume)),
        ]
        self.main = subprocess.Popen(
            ["swayidle", "-w",
             "timeout", str(int(timeout_s)), "kill -USR1 %d" % pid,
             "resume", "kill -USR2 %d" % pid],
            preexec_fn=_pdeathsig)

    def watch_resume(self):
        """Kézi aktiválásnál: 1 mp tétlenség után az első mozdulatra jelez."""
        self.cancel_resume()
        self.helper = subprocess.Popen(
            ["swayidle", "-w", "timeout", "1", "true",
             "resume", "kill -USR2 %d" % os.getpid()],
            preexec_fn=_pdeathsig)

    def cancel_resume(self):
        self._kill(self.helper)
        self.helper = None

    @staticmethod
    def _kill(p):
        if p is None:
            return
        try:
            p.terminate()
            try:
                p.wait(0.4)
            except subprocess.TimeoutExpired:
                p.kill()
                p.wait()
        except Exception:
            pass

    def stop(self):
        self.cancel_resume()
        self._kill(self.main)
        self.main = None
        for s in self.srcs:
            GLib.source_remove(s)
        self.srcs = []


class MutterBackend:
    """GNOME/Mutter IdleMonitor D-Bus API."""
    name = "mutter"
    BUS = "org.gnome.Mutter.IdleMonitor"
    PATH = "/org/gnome/Mutter/IdleMonitor/Core"

    @staticmethod
    def available():
        return "GNOME" in os.environ.get("XDG_CURRENT_DESKTOP", "").upper()

    def __init__(self):
        self.conn = None
        self.sub = None
        self.idle_id = None
        self.active_id = None
        self.on_idle = self.on_resume = None

    def _call(self, method, args, rtype):
        return self.conn.call_sync(self.BUS, self.PATH, self.BUS, method, args,
                                   GLib.VariantType(rtype) if rtype else None,
                                   Gio.DBusCallFlags.NONE, 2000, None)

    def start(self, timeout_s, on_idle, on_resume):
        self.on_idle, self.on_resume = on_idle, on_resume
        self.conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.sub = self.conn.signal_subscribe(self.BUS, self.BUS, "WatchFired", self.PATH,
                                              None, Gio.DBusSignalFlags.NONE, self._fired)
        self.idle_id = self._call("AddIdleWatch",
                                  GLib.Variant("(t)", (int(timeout_s * 1000),)), "(u)").unpack()[0]

    def _fired(self, *a):
        wid = a[5].unpack()[0]
        if wid == self.idle_id:
            self.on_idle()
        elif wid == self.active_id:
            self.active_id = None
            self.on_resume()

    def watch_resume(self):
        if self.active_id is not None:
            return
        try:
            self.active_id = self._call("AddUserActiveWatch", None, "(u)").unpack()[0]
        except GLib.Error as e:
            log("AddUserActiveWatch:", e.message)

    def cancel_resume(self):
        if self.active_id is not None:
            try:
                self._call("RemoveWatch", GLib.Variant("(u)", (self.active_id,)), None)
            except GLib.Error:
                pass
            self.active_id = None

    def stop(self):
        self.cancel_resume()
        try:
            if self.idle_id is not None:
                self._call("RemoveWatch", GLib.Variant("(u)", (self.idle_id,)), None)
        except GLib.Error:
            pass
        if self.sub is not None:
            self.conn.signal_unsubscribe(self.sub)
        self.sub = self.idle_id = None


