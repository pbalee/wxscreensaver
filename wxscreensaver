def ctl(method):
    try:
        conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        r = conn.call_sync(BUS_NAME, CTL_PATH, CTL_IFACE, method, None, None,
                           Gio.DBusCallFlags.NONE, 1500, None)
        u = r.unpack() if r is not None else ()
        return True, (u[0] if u else "")
    except GLib.Error as e:
        return False, e.message


